      "source": [
        "### Stage 1: Duplicates\n",
        "We start from a fresh copy of the raw table. No job_id is repeated, but 12,695 postings have the same company, title and description under a new job_id. We ignore location, so the same job posted in several cities counts once. We remove them, which leaves 111,154 postings. To redo the cleaning from scratch, rerun this cell and the cells after it."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 165,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "collapsed": true,
        "id": "eXLVYoJrIsHb",
        "outputId": "413621b3-4ef0-485d-afc3-7277f16de8f0"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Repeated job_id: 0\n",
            "Same post, new job_id: 12695\n"
          ]
        }
      ],
      "source": [
        "# fresh copy: rerunning this cell restarts the cleaning\n",
        "jobs = jobs_raw.copy()\n",
        "log = [('raw file', len(jobs))]   # rows left after each step\n",
        "\n",
        "print(\"Repeated job_id:\", jobs['job_id'].duplicated().sum())\n",
        "\n",
        "# compare without spaces at the start/end, so near-copies are caught\n",
        "key = jobs[['company_name', 'title', 'description']].apply(lambda s: s.str.strip())\n",
        "same_post = key.duplicated() & jobs['description'].notna()\n",
        "print(\"Same post, new job_id:\", same_post.sum())\n",
        "\n",
        "jobs = jobs.drop_duplicates(subset='job_id')\n",
        "jobs = jobs[~same_post.reindex(jobs.index, fill_value=False)].reset_index(drop=True)\n",
        "log.append(('after removing duplicates', len(jobs)))"
      ]
    },
