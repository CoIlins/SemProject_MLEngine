        "         'Title only': 'Resume_title'}\n",
        "\n",
        "# cross-validate on the training resumes, then score the test resumes once\n",
        "def evaluate(model_name, model, text_name, column):\n",
        "    x_train = df_model.loc[train_idx, column]\n",
        "    x_test = df_model.loc[test_idx, column]\n",
        "\n",
        "    cv_scores = cross_validate(make_pipeline(model), x_train, y_train, cv=cv,\n",
        "                               scoring=['accuracy', 'f1_macro'], n_jobs=-1)\n",
        "    pipeline = make_pipeline(model).fit(x_train, y_train)\n",
        "    predicted = pipeline.predict(x_test)\n",
        "\n",
        "    row = {'Model': model_name, 'Text': text_name,\n",
        "           'CV accuracy': cv_scores['test_accuracy'].mean(),\n",
        "           'CV accuracy spread': cv_scores['test_accuracy'].std(),\n",
        "           'CV macro-F1': cv_scores['test_f1_macro'].mean(),\n",
        "           'CV macro-F1 spread': cv_scores['test_f1_macro'].std(),\n",
        "           'Test accuracy': accuracy_score(y_test, predicted),\n",
        "           'Test macro-F1': f1_score(y_test, predicted, average='macro')}\n",
        "    return row, pipeline\n",
        "\n",
        "rows, fitted = [], {}\n",
        "for model_name, model in models.items():\n",
        "    for text_name, column in texts.items():\n",
        "        # the baseline does not read the text, so one run is enough\n",
        "        if model_name == BASELINE and text_name != 'With title':\n",
        "            continue\n",
        "        row, fitted[(model_name, text_name)] = evaluate(model_name, model, text_name, column)\n",
        "        rows.append(row)\n",
        "\n",
        "results = pd.DataFrame(rows)\n",
        "display(results[['Model', 'Text', 'CV accuracy', 'CV macro-F1', 'Test accuracy', 'Test macro-F1']].round(3))"
