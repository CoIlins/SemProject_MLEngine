        "print('Unknown skill type:', bad_type.sum())\n",
        "print('Unknown reuse level:', bad_reuse.sum())\n",
        "\n",
        "bad = blank_label | no_letters | bad_uri | bad_type | bad_reuse\n",
        "skills = skills[~bad].reset_index(drop=True)\n",
        "skills_log.append(('after removing incorrect data', len(skills)))"
