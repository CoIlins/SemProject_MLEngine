      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Minimum above maximum: 0\n",
            "Not in USD: 14\n",
            "Outside the salary limits: 439\n",
            "Views / applies below zero: 0 / 0\n"
          ]
        }
      ],
      "source": [
        "wrong_range = jobs.query('min_salary > max_salary')\n",
        "not_usd = jobs['currency'].notna() & (jobs['currency'] != 'USD')\n",
        "\n",
        "LOW, HIGH = 10_000, 1_000_000          # our limits for a yearly salary\n",
        "unlikely = jobs['normalized_salary'].notna() & ~jobs['normalized_salary'].between(LOW, HIGH)\n",
        "\n",
        "print(\"Minimum above maximum:\", len(wrong_range))\n",
        "print(\"Not in USD:\", not_usd.sum())\n",
        "print(\"Outside the salary limits:\", unlikely.sum())\n",
        "print(\"Views / applies below zero:\", (jobs['views'] < 0).sum(), \"/\", (jobs['applies'] < 0).sum())\n",
        "\n",
        "# blank the salary, but keep the posting\n",
        "bad_salary = unlikely | not_usd | jobs.index.isin(wrong_range.index)\n",
        "jobs.loc[bad_salary, 'normalized_salary'] = np.nan\n",
        "for col in ['views', 'applies']:\n",
        "    jobs.loc[jobs[col] < 0, col] = np.nan\n",
        "\n",
        "jobs = jobs.drop(columns=['min_salary', 'med_salary', 'max_salary', 'pay_period',\n",
