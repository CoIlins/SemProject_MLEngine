        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from sklearn.decomposition import TruncatedSVD\n",
        "from sklearn.preprocessing import Normalizer\n",
        "\n",
        "# three ways to turn a resume into numbers\n",
        "representations = {\n",
        "    'Word counts': CountVectorizer(stop_words='english', min_df=5, max_df=0.8, max_features=20000),\n",
        "    'TF-IDF': TfidfVectorizer(stop_words='english', min_df=5, max_df=0.8, sublinear_tf=True, max_features=20000),\n",
        "    'TF-IDF + LSA': Pipeline([\n",
        "        ('tfidf', TfidfVectorizer(stop_words='english', min_df=5, max_df=0.8, sublinear_tf=True, max_features=20000)),\n",
        "        ('lsa', TruncatedSVD(n_components=200, random_state=42)),\n",
        "        ('scale', Normalizer())]),\n",
        "}\n",
        "\n",
        "# share of the 5 closest training resumes that have the same category as the test resume\n",
        "def resume_precision_at_5(representation, column):\n",
        "    representation = clone(representation)\n",
        "    train_vectors = representation.fit_transform(df_model.loc[train_idx, column])\n",
        "    test_vectors = representation.transform(df_model.loc[test_idx, column])\n",
        "    closest = np.argsort(-cosine_similarity(test_vectors, train_vectors), axis=1)[:, :5]\n",
        "    return (y_train.to_numpy()[closest] == y_test.to_numpy()[:, None]).mean()\n",
        "\n",
        "resume_scores = pd.DataFrame({\n",
        "    name: {'With title': resume_precision_at_5(rep, 'Resume_clean'),\n",
        "           'Without title': resume_precision_at_5(rep, 'Resume_notitle')}\n",
        "    for name, rep in representations.items()}).T\n",
        "display(resume_scores.round(3))\n",
        "\n",
        "# chance: how often a random training resume has the same category as a test resume\n",
        "chance_resumes = (y_train.value_counts(normalize=True) * y_test.value_counts(normalize=True)).sum()\n",
        "print('Chance level:', round(chance_resumes, 3))"
      ]
    },
