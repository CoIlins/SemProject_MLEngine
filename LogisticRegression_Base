        "# internship and entry-level postings only\n",
        "early_jobs = df_jobs[df_jobs['is_internship'] | (df_jobs['experience_level'] == 'Entry level')]\n",
        "early_jobs = early_jobs.drop_duplicates(subset=['title', 'company_name']).reset_index(drop=True)\n",
        "\n",
        "# words learned from the training resumes and these postings\n",
        "match_tfidf = TfidfVectorizer(stop_words='english', min_df=5, max_df=0.8, sublinear_tf=True, max_features=20000)\n",
        "match_tfidf.fit(pd.concat([df_model.loc[train_idx, 'Resume_notitle'], early_jobs['job_text']]))\n",
        "early_vectors = match_tfidf.transform(early_jobs['job_text'])\n",
        "\n",
        "# the closest postings to a resume\n",
        "def match(resume_text, top_k=5):\n",
        "    similarity = cosine_similarity(match_tfidf.transform([resume_text]), early_vectors).ravel()\n",
        "    best = similarity.argsort()[::-1][:top_k]\n",
        "    result = early_jobs.loc[best, ['title', 'company_name']].copy()\n",
        "    result['similarity'] = similarity[best].round(2)\n",
        "    return result\n",
        "\n",
        "# one test resume from three categories\n",
        "test_resumes = df_model.loc[test_idx]\n",
        "for category in ['HR', 'CHEF', 'INFORMATION-TECHNOLOGY']:\n",
        "    resume = test_resumes[test_resumes['Category'] == category].iloc[0]\n",
        "    print('\\nResume category:', category)\n",
        "    print(match(resume['Resume_notitle']).to_string(index=False))"
