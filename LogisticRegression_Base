      "source": [
        "skills['n_synonyms']  = skills['synonyms'].map(lambda s: len([x for x in s.split('\\n') if x.strip()]))\n",
        "skills['label_words'] = skills['skill'].str.split().str.len()\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(9, 3.5))\n",
        "for ax, col in zip(axes, ['n_synonyms', 'label_words']):\n",
        "    sns.boxplot(y=skills[col], ax=ax)\n",
        "    ax.set_title(col)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "for col in ['n_synonyms', 'label_words']:\n",
        "    q1, q3 = skills[col].quantile([0.25, 0.75])\n",
        "    iqr = q3 - q1\n",
        "    n = ((skills[col] < q1 - 1.5*iqr) | (skills[col] > q3 + 1.5*iqr)).sum()\n",
        "    print(f\"{col}: {n} outliers\")\n",
        "    print('one word:', (skills['label_words'] == 1).sum(), '| six words or more:', (skills['label_words'] >= 6).sum())\n",
        "\n",
        "display(skills.nlargest(5, 'n_synonyms')[['skill', 'n_synonyms']])\n",
        "display(skills.nlargest(5, 'label_words')[['skill', 'label_words']])\n",
        "skills_log.append(('after checking outliers (none removed)', len(skills)))"
      ]
    },
