          "text": [
            "Share of the posting skills the resume shows, closest postings: 0.337\n",
            "Share of the posting skills the resume shows, random postings:  0.176\n"
          ]
        }
      ],
      "source": [
        "# share of a posting's skills that the resume also shows\n",
        "def skill_overlap(resume_skills, job_skills):\n",
        "    return len(resume_skills & job_skills) / len(job_skills) if job_skills else 0\n",
        "\n",
        "# 100 test resumes: their 5 closest postings against 5 random postings\n",
        "rng = np.random.default_rng(42)\n",
        "matched_overlap, random_overlap = [], []\n",
        "for text in df_model.loc[rng.choice(test_idx, 100, replace=False), 'Resume_notitle']:\n",
        "    resume_skills = find_skills(text)\n",
        "    matched_jobs = early_jobs.loc[match(text).index, 'job_text']\n",
        "    random_jobs = early_jobs['job_text'].iloc[rng.choice(len(early_jobs), 5, replace=False)]\n",
        "    matched_overlap += [skill_overlap(resume_skills, find_skills(t)) for t in matched_jobs]\n",
        "    random_overlap += [skill_overlap(resume_skills, find_skills(t)) for t in random_jobs]\n",
        "\n",
        "print('Share of the posting skills the resume shows, closest postings:', round(np.mean(matched_overlap), 3))\n",
        "print('Share of the posting skills the resume shows, random postings: ', round(np.mean(random_overlap), 3))"
      ]
    },
