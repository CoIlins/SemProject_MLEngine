        "bad_uri     = ~skills['conceptUri'].str.startswith('http://data.europa.eu/esco/skill/', na=False)\n",
        "bad_type    = skills['skillType'].notna() & ~skills['skillType'].isin(ALLOWED_TYPES)\n",
        "bad_reuse   = skills['reuseLevel'].notna() & ~skills['reuseLevel'].isin(ALLOWED_REUSE)\n",
