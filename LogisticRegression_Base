      "source": [
        "# words in a job title that point to one resume category (the first match wins)\n",
        "TITLE_PATTERNS = {\n",
        "    'INFORMATION-TECHNOLOGY': r'software|developer|network|help desk|it support|system administrator',\n",
        "    'ACCOUNTANT': r'accountant|accounting|bookkeeper',\n",
        "    'BANKING': r'\\bbank|teller',\n",
        "    'CHEF': r'\\bchef|\\bcook\\b|kitchen',\n",
        "    'CONSTRUCTION': r'construction|carpenter|electrician|plumber',\n",
        "    'ENGINEERING': r'engineer',\n",
        "    'FINANCE': r'financ',\n",
        "    'FITNESS': r'fitness|personal trainer',\n",
        "    'HEALTHCARE': r'\\bnurse|medical|patient care|clinical|pharmac',\n",
        "    'HR': r'\\bhr\\b|human resources|recruiter',\n",
        "    'SALES': r'\\bsales',\n",
        "    'TEACHER': r'teacher|tutor|instructor',\n",
        "}\n",
        "\n",
        "def title_category(title):\n",
        "    for category, pattern in TITLE_PATTERNS.items():\n",
        "        if re.search(pattern, title):\n",
        "            return category\n",
        "    return None\n",
        "\n",
        "df_jobs['title_clean'] = df_jobs['title_clean'].fillna('')\n",
        "df_jobs['title_category'] = df_jobs['title_clean'].apply(title_category)\n",
        "\n",
        "# posting text without the title, so the label cannot leak into the match\n",
        "df_jobs['job_body'] = [text[len(title):].strip() for text, title in zip(df_jobs['job_text'], df_jobs['title_clean'])]\n",
        "\n",
        "# up to 300 postings for each category\n",
        "labelled_jobs = (df_jobs[df_jobs['title_category'].notna()]\n",
        "                 .sample(frac=1, random_state=42)\n",
        "                 .groupby('title_category').head(300)\n",
        "                 .reset_index(drop=True))\n",
        "display(labelled_jobs['title_category'].value_counts())\n",
        "\n",
        "# test resumes from the categories that have labelled postings\n",
        "in_scope = test_idx[df_model.loc[test_idx, 'Category'].isin(labelled_jobs['title_category'].unique())]\n",
        "resume_labels = df_model.loc[in_scope, 'Category'].to_numpy()\n",
        "\n",
        "# words learned from the training resumes and the labelled postings\n",
        "job_tfidf = TfidfVectorizer(stop_words='english', min_df=5, max_df=0.8, sublinear_tf=True, max_features=20000)\n",
        "job_tfidf.fit(pd.concat([df_model.loc[train_idx, 'Resume_notitle'], labelled_jobs['job_body']]))\n",
        "text_similarity = cosine_similarity(job_tfidf.transform(df_model.loc[in_scope, 'Resume_notitle']),\n",
        "                                    job_tfidf.transform(labelled_jobs['job_body']))\n",
        "\n",
        "# for each resume, is each of the 5 closest postings in the resume's category?\n",
        "def top5_hits(similarity):\n",
        "    closest = np.argsort(-similarity, axis=1)[:, :5]\n",
        "    return labelled_jobs['title_category'].to_numpy()[closest] == resume_labels[:, None]\n",
        "\n",
        "share = labelled_jobs['title_category'].value_counts(normalize=True)\n",
        "chance_jobs = pd.Series(resume_labels).map(share).mean()\n",
        "print('Precision@5:', round(top5_hits(text_similarity).mean(), 3), '| chance level:', round(chance_jobs, 3))\n",
        "\n",
        "per_category = (pd.DataFrame({'Category': resume_labels, 'precision@5': top5_hits(text_similarity).mean(axis=1)})\n",
        "                .groupby('Category')['precision@5'].agg(['mean', 'count']))\n",
        "print(per_category.round(2).to_string())"
      ]
