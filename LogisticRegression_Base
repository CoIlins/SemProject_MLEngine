        "# every ESCO skill found in a text, with the words around it\n",
        "def skill_hits(text, window=4):\n",
        "    words = text.split()\n",
        "    hits = []\n",
        "    for n in (1, 2, 3, 4):\n",
        "        for i in range(len(words) - n + 1):\n",
        "            spelling = ' '.join(words[i:i + n])\n",
        "            if spelling in lookup_dict:\n",
        "                hits.append((spelling, lookup_dict[spelling], ' '.join(words[max(0, i - window):i + n + window])))\n",
        "    return hits\n",
        "\n",
        "# one random skill hit from each of 30 random test resumes\n",
        "rng = np.random.default_rng(42)\n",
        "check = []\n",
        "for text in df_model.loc[rng.choice(test_idx, 30, replace=False), 'Resume_notitle']:\n",
        "    hits = skill_hits(text)\n",
        "    if hits:\n",
        "        spelling, skill, context = hits[rng.integers(len(hits))]\n",
        "        check.append({'found as': spelling, 'skill': skill, 'context': context})\n",
        "check = pd.DataFrame(check)\n",
        "pd.set_option('display.max_colwidth', 100)\n",
        "display(check)"
