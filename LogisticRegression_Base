      "source": [
        "# if a line starts with one of these words, it is a heading and not a title\n",
        "SECTION_WORDS = ('summary','skills','skill','experience','education','objective',\n",
        "                 'profile','highlights','qualifications','career','professional')\n",
        "\n",
        "# a title is a short line that is almost all capital letters\n",
        "def is_title_chunk(chunk):\n",
        "    letters = [c for c in chunk if c.isalpha()]\n",
        "    if not letters or len(chunk) > 80:\n",
        "        return False\n",
        "    first_word = (re.findall(r'[a-z]+', chunk.lower()) or [''])[0]\n",
        "    return sum(c.isupper() for c in letters)/len(letters) > 0.8 and first_word not in SECTION_WORDS\n",
        "\n",
        "# remove up to 2 title lines from the start\n",
        "def split_title(raw, max_chunks=2):\n",
        "    rest = raw.strip()\n",
        "    removed = []\n",
        "    for _ in range(max_chunks):\n",
        "        parts = re.split(r'\\s{2,}', rest, maxsplit=1)\n",
        "        if len(parts) == 2 and is_title_chunk(parts[0]):\n",
        "            removed.append(parts[0])\n",
        "            rest = parts[1]\n",
        "        else:\n",
        "            break\n",
        "    return (' | '.join(removed) if removed else None), rest\n",
        "\n",
        "res = df['Resume_str'].apply(split_title)\n",
        "df['Resume_title'] = res.apply(lambda x: x[0] or '')\n",
        "df['has_title'] = df['Resume_title'] != ''\n",
        "df['Resume_notitle'] = res.apply(lambda x: clean_text(strip_boilerplate(x[1])))\n",
        "\n",
        "print(\"Resumes starting with a title:\", df['has_title'].sum(), \"of\", len(df))\n",
