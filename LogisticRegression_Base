      "source": [
        "### Skill lookup\n",
        "We build one table with every spelling of every skill (name, synonyms, hidden labels). We drop spellings of 1 or 2 letters, like \"it\" or \"pr\", because they match ordinary words, but we keep c#. This gives 101,461 spellings. If two skills share a spelling (716 cases), the skill name wins over a synonym, and a synonym wins over a hidden label. This leaves 99,874 spellings. This lookup is how we will find skills in resumes and postings. A check shows that \"python\" is found, but \"teamwork\" and \"docker\" are not."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 186,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "wzYfKGEhcfwp",
        "outputId": "77f32bd7-4c77-43cd-eaf4-aa14b977f3e1"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "spellings: 101461\n"
          ]
        }
      ],
      "source": [
        "lookup_rows = []\n",
        "for r in skills.itertuples(index=False):\n",
        "    meta = dict(canonical=r.skill, uri=r.skill_uri, skill_type=r.skill_type)\n",
        "    lookup_rows.append(dict(label=r.skill, label_kind='preferred', **meta))\n",
        "    for field, kind in ((r.synonyms, 'alt'), (r.hidden_labels, 'hidden')):\n",
        "        for lab in field.split('\\n'):\n",
        "            if lab.strip():\n",
        "                lookup_rows.append(dict(label=lab.strip(), label_kind=kind, **meta))\n",
        "\n",
        "lookup = pd.DataFrame(lookup_rows)\n",
        "lookup['label_norm'] = lookup['label'].apply(clean_text)\n",
        "lookup = lookup[lookup['label_norm'] != '']\n",
        "# remove spellings of 1 or 2 letters (they match inside ordinary text), but keep c#\n",
        "lookup = lookup[(lookup['label_norm'].str.len() > 2) | (lookup['label_norm'] == 'c#')]\n",
        "print('spellings:', len(lookup))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 187,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "E8KD3OItclXj",
        "outputId": "89cced12-2c34-4148-b27f-32861765bba3"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "spellings pointing at more than one skill: 716\n",
            "unique spellings kept: 99874\n",
            "'python'               -> Python (computer programming)\n",
            "'project management'   -> project management\n",
            "'MS Excel'             -> use spreadsheets software\n",
            "'teamwork'             -> None\n",
            "'react'                -> JavaScript Framework\n",
            "'docker'               -> None\n"
          ]
        }
      ],
      "source": [
        "# The same cleaned spelling can point at more than one skill (a \"clash\").\n",
        "# Count them, then keep the best: skill names win over synonyms, which win over hidden labels.\n",
        "clashes = lookup.groupby('label_norm')['uri'].nunique()\n",
        "print('spellings pointing at more than one skill:', (clashes > 1).sum())\n",
        "\n",
        "kind_rank = {'preferred': 0, 'alt': 1, 'hidden': 2}\n",
        "lookup = (lookup.assign(_o=lookup['label_kind'].map(kind_rank))\n",
        "                .sort_values(['label_norm', '_o', 'canonical'])\n",
        "                .drop_duplicates('label_norm')\n",
        "                .drop(columns='_o')\n",
        "                .reset_index(drop=True))\n",
        "print('unique spellings kept:', len(lookup))\n",
        "\n",
        "lookup_dict = dict(zip(lookup['label_norm'], lookup['canonical']))   # cleaned phrase -> official skill name\n",
        "lookup.to_csv(os.path.join(OUT_DIR_SKILLS, 'esco_lookup.csv'), index=False)\n",
        "\n",
        "# sanity check: None means ESCO does not know that spelling\n",
        "for phrase in ['python', 'project management', 'MS Excel', 'teamwork', 'react', 'docker']:\n",
        "    print(f\"{phrase!r:22} ->\", lookup_dict.get(clean_text(phrase)))"
      ]
    },
